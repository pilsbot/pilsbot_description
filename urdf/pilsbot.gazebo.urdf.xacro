<?xml version="1.0"?>
<!-- Gazebo Fortress (gz sim 6) only. SPIKE pilsbot/pilsbot_simulation#1. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="wheel_mu" default="1.0"/>

  <xacro:macro name="wheel_surface" params="link">
    <gazebo reference="${link}">
      <mu1>$(arg wheel_mu)</mu1>
      <mu2>$(arg wheel_mu)</mu2>
    </gazebo>
  </xacro:macro>

  <!-- A camera sensor at an OAK camera frame (x forward). The image header
       names the optical frame; gz publishes camera_info next to the image. -->
  <xacro:macro name="oak_camera" params="name frame topic type:=camera hfov width height format rate">
    <gazebo reference="oak_${frame}_camera_frame">
      <sensor name="${name}" type="${type}">
        <always_on>true</always_on>
        <update_rate>${rate}</update_rate>
        <topic>${topic}</topic>
        <ignition_frame_id>oak_${frame}_camera_optical_frame</ignition_frame_id>
        <camera>
          <horizontal_fov>${hfov}</horizontal_fov>
          <image>
            <width>${width}</width>
            <height>${height}</height>
            <format>${format}</format>
          </image>
          <clip>
            <near>0.2</near>
            <far>20.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="pilsbot_gazebo" params="config overrides">
    <xacro:wheel_surface link="front_wheel_left"/>
    <xacro:wheel_surface link="front_wheel_right"/>
    <xacro:wheel_surface link="rear_wheel_left"/>
    <xacro:wheel_surface link="rear_wheel_right"/>

    <!-- OAK-D Lite: colour 1280x720 (1080p ISP-scaled 2/3), mono pair 400p,
         stereo depth aligned to the left mono camera. Topic names of the
         Humble pilsbot_depthai mjpeg_node. -->
    <xacro:oak_camera name="oak_rgb" frame="rgb" topic="camera/color/image_raw"
                      hfov="1.20" width="1280" height="720" format="R8G8B8" rate="30"/>
    <xacro:oak_camera name="oak_left" frame="left" topic="camera/left/image_rect"
                      hfov="1.27" width="640" height="400" format="L8" rate="15"/>
    <xacro:oak_camera name="oak_right" frame="right" topic="camera/right/image_rect"
                      hfov="1.27" width="640" height="400" format="L8" rate="15"/>
    <xacro:oak_camera name="oak_depth" frame="left" topic="camera/stereo/depth" type="depth_camera"
                      hfov="1.27" width="640" height="400" format="R_FLOAT32" rate="15"/>

    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find pilsbot_control)/config/${config}</parameters>
        <parameters>${overrides}</parameters>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
